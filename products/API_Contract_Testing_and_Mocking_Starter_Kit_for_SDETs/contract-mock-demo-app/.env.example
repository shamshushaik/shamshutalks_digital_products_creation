# contract-mock-demo-app — Environment Variables
# Copy this file to .env and adjust values
# What: PORT controls which port the Express provider listens on
# Why: Lets you avoid port conflicts (e.g., WireMock on 8080, provider on 3000)
# Where: companion_files/contract-mock-demo-app/.env

PORT=3000
# Pact output directory — where consumer tests write pact JSON
PACT_DIR=./pacts
# Provider base URL for Verifier (template-05)
PROVIDER_BASE_URL=http://localhost:3000
