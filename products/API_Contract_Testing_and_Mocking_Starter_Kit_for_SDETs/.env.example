# API Contract Testing and Mocking Starter Kit — Environment Variables
# What: Central env vars for demo app + WireMock + Pact
# Why: Lets you change ports without editing code — one place to configure
# Where: Product root .env.example → copy to .env in each sub-project as needed
# How: cp .env.example .env  (or copy to companion_files/contract-mock-demo-app/.env)
# Expected: No errors — just config, no secrets

# ── Demo Provider (Express) ───────────────────────────────────────────
# What: PORT controls Express provider port (demo app)
# Why: Avoid port conflicts (WireMock on 8080, provider on 3000)
PORT=3000

# ── WireMock (Mock Server) ────────────────────────────────────────────
# What: WIREMOCK_URL is where WireMock is running
# Why: Lets you change port if 8080 is in use
WIREMOCK_URL=http://localhost:8080
WIREMOCK_PORT=8080

# ── Pact (Contract Testing) ───────────────────────────────────────────
# What: PACT_DIR is where pact JSON is written
# Why: Consumer tests write pacts/*.json, Verifier reads it
PACT_DIR=./pacts
PROVIDER_BASE_URL=http://localhost:3000

# ── UI Against Mock (Env Var Switch) ──────────────────────────────────
# What: VITE_API_URL / REACT_APP_API_URL / NEXT_PUBLIC_API_URL — UI points to mock or real API
# Why: No code change — just env var. Point to WireMock while backend builds, then to real API.
# Example:
#   VITE_API_URL=http://localhost:8080          # WireMock (while backend builds)
#   VITE_API_URL=http://localhost:3000          # Demo provider (local)
#   VITE_API_URL=https://api.example.com        # Real backend (production)
VITE_API_URL=http://localhost:8080
REACT_APP_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
