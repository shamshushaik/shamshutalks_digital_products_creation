  "description": "Practice Lab for API Contract Testing and Mocking Starter Kit — 5 exercises with helpers and data-factory",
  "private": true,
  "scripts": {
    "test": "jest --runInBand --testTimeout=30000",
    "test:exercise1": "jest --runInBand exercises/01-break-field-removal --testTimeout=30000",
    "test:exercise2": "jest --runInBand exercises/02-break-type-change --testTimeout=30000",
    "test:exercise3": "jest --runInBand exercises/03-add-required-field --testTimeout=30000",
    "test:exercise4": "jest --runInBand exercises/04-wiremock-templating --testTimeout=30000",
    "test:exercise5": "jest --runInBand exercises/05-ui-against-mock --testTimeout=30000"
