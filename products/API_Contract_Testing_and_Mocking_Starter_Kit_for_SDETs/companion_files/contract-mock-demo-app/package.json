{
  "name": "contract-mock-demo-app",
  "version": "1.0.0",
  "description": "Demo provider API for API Contract Testing and Mocking Starter Kit — Express with 5 endpoints matching Pact templates",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --runInBand --testTimeout=30000",
    "test:consumer": "jest --runInBand --testPathPattern=template-0[1-4] --testTimeout=30000",
    "test:provider": "jest --runInBand --testPathPattern=template-05 --testTimeout=30000"
  },
  "keywords": ["pact", "contract-testing", "wiremock", "sdet", "api-mocking"],
  "author": "ShamshuTalks — SDET Series",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.3",
    "axios": "^1.6.7",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
