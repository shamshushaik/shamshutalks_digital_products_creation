{
  "chat.promptFilesRecommendations": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.customAgents.enabled": true,
  "github.copilot.chat.skills.enabled": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  },
  "github.copilot.enable": {
    "*": true
  },
  "files.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/__pycache__": true
  }
}
